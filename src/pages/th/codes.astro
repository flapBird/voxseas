---
import ThaiLayout from '../../layouts/ThaiLayout.astro';
import CodeList from '../../components/CodeList.astro';
import { confirmedExpiredCodes, historicalExpiryReports, codesReviewedISO, formatCodesReview, pendingCodes } from '../../data/codes';
const headings = [
  { depth: 2, slug: 'working-codes', text: 'โค้ดที่แนะนำให้ลอง' },
  { depth: 2, slug: 'redeem', text: 'วิธีแลกโค้ดในเกม' },
  { depth: 2, slug: 'expired-codes', text: 'โค้ดเก่า' },
];
---
<ThaiLayout {headings} frontmatter={{ title: 'โค้ด Vox Seas ล่าสุด', description: 'รวมโค้ดแลกโบนัส XP และโทเคนรีเซ็ตค่าสถานะ พร้อมวิธีแลกโค้ดและสถานะของโค้ดเก่า', updatedISO: codesReviewedISO }}>
  <p>ตรวจสอบจากรายงานสาธารณะล่าสุดเมื่อ <time datetime={codesReviewedISO}>{formatCodesReview('th')}</time> โค้ดอาจหมดอายุได้ ควรแลกโบนัส XP ตอนที่พร้อมเริ่มฟาร์ม</p>
  <section class="codes-page-panel">
    <h2 id="working-codes">โค้ดที่แนะนำให้ลอง</h2><CodeList lang="th" />
    {pendingCodes.length > 0 && <><h3>โค้ดที่อาจหมดอายุ</h3><CodeList lang="th" pending /></>}
  </section>
  <h2 id="redeem">วิธีแลกโค้ดในเกม</h2>
  <ol><li>เปิด Menu แล้วกดไอคอนรูปเฟืองเพื่อเข้า Settings</li><li>เลื่อนลงไปที่ช่อง CODES แล้ววางโค้ดให้ตรงทั้งตัวพิมพ์เล็กและตัวพิมพ์ใหญ่</li><li>กด REDEEM แล้วอ่านข้อความยืนยัน หากแลกไม่ได้ ให้ตรวจสอบช่องว่างหรือลองเข้าเซิร์ฟเวอร์ใหม่</li></ol>
  <h2 id="expired-codes">โค้ดเก่า</h2><p>จะยืนยันว่าโค้ดหมดอายุเมื่อผู้พัฒนาประกาศหรือเกมแสดงข้อความ Expired สำหรับโค้ดนั้น</p>
  <ul>{historicalExpiryReports.map(code => <li><code>{code}</code> — อาจหมดอายุ</li>)}</ul>
  {confirmedExpiredCodes.length > 0 && <><h3>ยืนยันว่าหมดอายุแล้ว</h3><ul>{confirmedExpiredCodes.map(code => <li><code>{code}</code> — หมดอายุแล้ว</li>)}</ul></>}
</ThaiLayout>
