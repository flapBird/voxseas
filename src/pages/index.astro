---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CodeList from '../components/CodeList.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { guides } from '../data/guides';
import { codes, site } from '../data/site';
import heroArt from '../assets/art/hero-official-v1.png';
import mapArt from '../assets/art/world-map-gameplay-v1.webp';

const title = 'Vox Seas Wiki – Códigos, Frutas, Mapa e Guias';
const description = 'Wiki brasileira de Vox Seas no Roblox. Copie códigos, siga o guia para iniciantes e consulte frutas, armas, raças, chefes e ilhas.';
const featuredPaths = ['/frutas/', '/mapa/', '/tier-list/', '/armas/', '/chefes/', '/racas/'];
const featuredGuides = featuredPaths.flatMap((path) => guides.filter((guide) => guide.href === path));
const communityGuides = guides.filter((guide) => guide.group === 'comunidade');
const firstSteps = [
  { title: 'Comece em Solmar', description: 'Fale com Hango e siga a investigação da Marine para ganhar o Cutlass.', href: '/iniciante/#comece-em-solmar' },
  { title: 'Prepare o primeiro barco', description: 'Reivindique o barco, o martelo e o mapa antes de atravessar.', href: '/iniciante/#prepare-o-primeiro-barco' },
  { title: 'Consiga sua primeira fruta', description: 'Volte de Forbidden Island com a Sacred Flower e procure Hango.', href: '/iniciante/#consiga-sua-primeira-fruta' },
];
const homeFaqs = [
  { question: 'O que é Vox Seas?', answer: 'Vox Seas é um RPG de aventura pirata no Roblox. Você navega entre ilhas, segue missões de história e usa armas, frutas e estilos de luta para enfrentar inimigos e chefes.' },
  { question: 'Onde resgato códigos de Vox Seas?', answer: 'No jogo, abra o Menu e selecione o ícone de engrenagem. Role até CODES, cole um código da lista revisada e selecione REDEEM.' },
  { question: 'Como consigo minha primeira fruta?', answer: 'Você pode receber uma fruta de Hango ao avançar na história, comprar uma oferta na loja ou usar o Vox Gacha em Harbor Island e Wandering Bastille.' },
  { question: 'O que significa Legacy?', answer: 'Legacy identifica dados da versão anterior de Vox Seas, como o ranking histórico de frutas. A versão Dawn of Legends pode ter poderes e mecânicas diferentes.' },
];
const schema = [
  { '@type': 'FAQPage', mainEntity: homeFaqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  { '@type': 'ItemList', name: 'Guias de Vox Seas', itemListElement: guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, name: guide.title, url: new URL(guide.href, site.url).href })) },
];
---
<BaseLayout title={title} description={description} path="/" schema={schema}>
  <section class="home-top" aria-labelledby="home-title">
    <div class="shell home-hero">
      <div class="hero-copy">
        <p class="hero-kicker">Dawn of Legends</p>
        <h1 id="home-title">Vox Seas <span>Wiki</span></h1>
        <p class="hero-subtitle">Copie códigos, encontre sua primeira fruta e planeje a próxima missão com guias de Vox Seas em português.</p>
        <div class="hero-actions">
          <a class="button" href="/iniciante/">Guia para iniciantes<Icon name="arrow" size={18} /></a>
          <a class="button button-secondary" href="/codigos/"><Icon name="ticket" size={18} />Ver códigos</a>
        </div>
        <a class="hero-search" href="/guias/" data-open-search>
          <Icon name="search" size={21} />
          <span>Buscar frutas, ilhas, NPCs ou códigos</span>
          <kbd data-search-shortcut hidden>Ctrl K</kbd>
        </a>
      </div>
      <figure class="hero-visual">
        <Picture src={heroArt} alt="Pirata sobre uma criatura marinha ao lado de um navio ao pôr do sol" widths={[480, 768]} sizes="(max-width: 620px) calc(100vw - 30px), (max-width: 800px) 625px, (max-width: 1230px) 44vw, 540px" formats={['avif', 'webp']} fallbackFormat="webp" quality={82} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><a href={site.robloxUrl} target="_blank" rel="noopener noreferrer">Arte oficial de Vox Seas <Icon name="external" size={13} /></a></figcaption>
      </figure>
    </div>
  </section>

  <div class="shell home-overview" id="explorar">
    <section aria-labelledby="overview-title">
      <div class="section-heading">
        <h2 id="overview-title">Explore a wiki</h2>
        <a class="text-link" href="/guias/">Todos os guias<Icon name="arrow" size={17} /></a>
      </div>
      <GuideLinks items={featuredGuides} />
    </section>
    <section class="home-codes" id="codigos" aria-labelledby="home-codes-title">
      <div class="home-codes-heading">
        <span class="guide-link-icon"><Icon name="ticket" size={22} /></span>
        <div><h2 id="home-codes-title">Códigos de Vox Seas</h2><p>Lista revisada em <time datetime={site.updatedISO}>{site.updated}</time></p></div>
      </div>
      <CodeList limit={3} />
      <div class="home-codes-links">
        <a class="text-link" href="/codigos/">Ver os {codes.length} códigos<Icon name="arrow" size={16} /></a>
        <a href="/codigos/#como-resgatar">Como resgatar</a>
      </div>
    </section>
  </div>

  <section class="start-section" aria-labelledby="start-title">
    <div class="shell start-guide">
      <figure class="start-art">
        <Picture src={mapArt} alt="Mapa-múndi do jogo com Solmar e as ilhas próximas" widths={[480, 768]} sizes="(max-width: 800px) calc(100vw - 30px), 45vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={80} loading="lazy" decoding="async" />
        <figcaption><a href="https://vox-seas-wiki.wiki/islands/" target="_blank" rel="noopener noreferrer">Captura de gameplay · Vox Seas Wiki <Icon name="external" size={13} /></a></figcaption>
      </figure>
      <div>
        <h2 id="start-title">Sua primeira viagem</h2>
        <ol class="start-steps">
          {firstSteps.map((step) => <li><a href={step.href}><span><strong>{step.title}</strong><small>{step.description}</small></span><Icon name="chevron" size={17} /></a></li>)}
        </ol>
        <a class="text-link" href="/iniciante/">Ler a rota completa<Icon name="arrow" size={17} /></a>
      </div>
    </div>
  </section>

  <section class="shell home-community" aria-labelledby="community-title">
    <div class="section-heading"><h2 id="community-title">Atualizações e comunidade</h2></div>
    <GuideLinks items={communityGuides} />
  </section>

  <section class="shell faq-home" aria-labelledby="faq-title">
    <div class="section-heading"><h2 id="faq-title">Perguntas frequentes</h2></div>
    <div class="faq-list">{homeFaqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
  </section>
</BaseLayout>
