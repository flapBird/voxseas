---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('en');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const portugueseAlternates: Record<string, string> = {
  'tier-list': '/tier-list/',
  discord: '/discord/',
  trello: '/trello/',
};
const alternates = portugueseAlternates[entry.id] ? { ptBR: portugueseAlternates[entry.id], en: `/en/${entry.id}/` } : {};
---
<GuideLayout guide={entry.data} headings={headings} lang="en" path={`/en/${entry.id}/`} alternates={alternates}>
  <Content />
</GuideLayout>
