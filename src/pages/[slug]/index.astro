---
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import GuideLayout from '../../layouts/GuideLayout.astro';
import ReferenceTable from '../../components/ReferenceTable.astro';
import { references } from '../../data/references';
import fruitsArt from '../../assets/art/fruitdex-gameplay-v1.webp';
import weaponsArt from '../../assets/art/cutlass-gameplay-v1.webp';
import mapArt from '../../assets/art/world-map-gameplay-v1.webp';
import bossArt from '../../assets/art/captain-jester-gameplay-v1.webp';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const reference = references[entry.id as keyof typeof references];
const sections = reference ? [{ depth: 2, ...reference.heading }, ...headings] : headings;
const englishAlternates: Record<string, string> = {
  'tier-list': '/en/tier-list/',
  discord: '/en/discord/',
  trello: '/en/trello/',
};
const alternates = englishAlternates[entry.id] ? { ptBR: `/${entry.id}/`, en: englishAlternates[entry.id] } : {};
const artwork: Record<string, { src: ImageMetadata; alt: string; credit: string; source: string }> = {
  frutas: {
    src: fruitsArt,
    alt: 'Interface do Fruitdex com a fruta Thorn e o progresso de descoberta em Vox Seas',
    credit: 'Captura de gameplay · Vox Seas Wiki',
    source: 'https://vox-seas-wiki.wiki/fruit-mechanics/',
  },
  armas: {
    src: weaponsArt,
    alt: 'Hango oferece a opção Take the Cutlass durante o diálogo em Vox Seas',
    credit: 'Captura de gameplay · Vox Seas Wiki',
    source: 'https://vox-seas-wiki.wiki/early-weapons/',
  },
  mapa: {
    src: mapArt,
    alt: 'Mapa-múndi de Vox Seas com Solmar Island, Harbor Island e Shark Park',
    credit: 'Captura de gameplay · Vox Seas Wiki',
    source: 'https://vox-seas-wiki.wiki/islands/',
  },
  chefes: {
    src: bossArt,
    alt: 'Batalha contra Captain Jester em uma arena com interface de combate de Vox Seas',
    credit: 'Captura de gameplay · Vox Seas Wiki',
    source: 'https://vox-seas-wiki.wiki/bosses/',
  },
};
const art = artwork[entry.id];
---
<GuideLayout guide={entry.data} headings={sections} path={`/${entry.id}/`} alternates={alternates} art={art?.src} artAlt={art?.alt} artCredit={art?.credit} artSource={art?.source}>
  <Fragment slot="reference">{reference && <ReferenceTable reference={reference} />}</Fragment>
  <Content />
</GuideLayout>
