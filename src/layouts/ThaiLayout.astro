---
import GuideLayout from './GuideLayout.astro';
import { getGuideLinks } from '../data/guides';
import mapArt from '../assets/art/world-map-gameplay-v1.webp';
import fruitArt from '../assets/art/fruitdex-gameplay-v1.webp';

const { frontmatter, headings = [] } = Astro.props;
const path = Astro.url.pathname;
const entry = getGuideLinks('th').find(item => item.href === path);
if (!entry) throw new Error(`Unknown Thai guide: ${path}`);
const { title, description, updatedISO } = frontmatter;
const guide = {
  title, description, updatedISO,
  shortTitle: entry.title, icon: entry.icon, eyebrow: entry.title,
  updated: new Intl.DateTimeFormat('th', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(updatedISO)),
  quickAnswer: frontmatter.quickAnswer, related: [], faqs: frontmatter.faqs ?? [],
};
const art = entry.route === 'map' ? mapArt : entry.route === 'fruits' ? fruitArt : undefined;
---
<GuideLayout {guide} {path} {headings} {art} artAlt={title} artCredit="ภาพจากเกม · Vox Seas Wiki" lang="th"><slot /></GuideLayout>
