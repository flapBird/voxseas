---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { categories, secondaryGuides, site } from '../data/site';

interface Heading { depth: number; slug: string; text: string; }
interface GuideData {
  title: string;
  shortTitle: string;
  description: string;
  eyebrow: string;
  icon: string;
  updated: string;
  quickAnswer: string;
  related: string[];
  faqs: { question: string; answer: string }[];
}
interface Props {
  guide: GuideData;
  headings: Heading[];
  lang?: 'pt-BR' | 'en';
  path: string;
  alternates?: { ptBR?: string; en?: string };
  art?: ImageMetadata;
  artAlt?: string;
  artCredit?: string;
  artSource?: string;
}
const { guide, headings, lang = 'pt-BR', path, alternates = {}, art, artAlt = '', artCredit = '', artSource } = Astro.props;
const isEn = lang === 'en';
const canonical = new URL(path, site.url).href;
const relatedPool = isEn ? [
  { title: 'Vox Seas codes', shortTitle: 'Codes', href: '/en/codes/', icon: 'ticket', description: 'Active codes, rewards and redemption steps.' },
  { title: 'Vox Seas tier list', shortTitle: 'Tier list', href: '/en/tier-list/', icon: 'sparkles', description: 'Legacy fruit rankings explained.' },
  { title: 'Vox Seas Discord', shortTitle: 'Discord', href: '/en/discord/', icon: 'discord', description: 'Find official community channels.' },
  { title: 'Vox Seas Trello', shortTitle: 'Trello', href: '/en/trello/', icon: 'trello', description: 'Track game information and updates.' },
] : [...categories, ...secondaryGuides];
const related = guide.related.map((slug) => relatedPool.find((item) => item.href === slug || item.href.includes(`/${slug}/`))).filter(Boolean).slice(0, 3);
const fallbackRelated = relatedPool.filter((item) => item.href !== path && !related.includes(item)).slice(0, 3 - related.length);
const relatedItems = [...related, ...fallbackRelated];
const articleSchema: Record<string, unknown> = {
  '@type': 'Article', '@id': `${canonical}#article`, headline: guide.title, description: guide.description, dateModified: site.updatedISO, inLanguage: lang,
  mainEntityOfPage: { '@id': `${canonical}#webpage` }, author: { '@id': `${site.url}/#organization` }, publisher: { '@id': `${site.url}/#organization` }, about: { '@id': `${site.url}/#game` },
  ...(art ? { image: new URL(art.src, site.url).href } : {}),
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: isEn ? 'Home' : 'Início', item: isEn ? `${site.url}/en/codes/` : `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: guide.shortTitle, item: canonical },
  ],
};
const schemas: Record<string, unknown>[] = [articleSchema, breadcrumbSchema];
if (guide.faqs.length) schemas.push({ '@type': 'FAQPage', mainEntity: guide.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) });
const toc = headings.filter((heading) => heading.depth === 2);
---
<BaseLayout title={guide.title} description={guide.description} lang={lang} path={path} alternates={alternates} schema={schemas} bodyClass="guide-page">
  <div class="shell guide-shell">
    <nav class="breadcrumbs" aria-label={isEn ? 'Breadcrumb' : 'Trilha de navegação'}><a href={isEn ? '/en/codes/' : '/'}>{isEn ? 'Home' : 'Início'}</a><Icon name="chevron" size={14} /><span>{guide.shortTitle}</span></nav>
    <header class="guide-hero">
      <div class="guide-hero-icon"><Icon name={guide.icon} size={32} /></div>
      <div class="guide-hero-copy">
        <p class="eyebrow">{guide.eyebrow}</p>
        <h1>{guide.title}</h1>
        <p class="guide-description">{guide.description}</p>
        <div class="guide-meta"><span><Icon name="clock" size={16} />{isEn ? 'Updated' : 'Atualizado em'} {guide.updated}</span><span><Icon name="book" size={16} />{isEn ? 'Independent player guide' : 'Guia independente para jogadores'}</span></div>
      </div>
    </header>
    <div class="quick-answer"><span class="quick-answer-label"><Icon name="sparkles" size={17} />{isEn ? 'QUICK ANSWER' : 'RESPOSTA RÁPIDA'}</span><p>{guide.quickAnswer}</p></div>
    {art && <figure class="guide-art"><Picture src={art} alt={artAlt} widths={[480, 768, 1200, 1280]} sizes="(max-width: 1180px) calc(100vw - 48px), 1180px" formats={['avif', 'webp']} fallbackFormat="webp" quality={80} loading="lazy" decoding="async" /><figcaption>{artSource ? <a href={artSource} target="_blank" rel="noopener noreferrer">{artCredit}</a> : artCredit}</figcaption></figure>}
    <div class="guide-layout">
      <article class="guide-article">
        <div class="prose"><slot /></div>
        {guide.faqs.length > 0 && <section class="faq-section"><p class="eyebrow">{isEn ? 'COMMON QUESTIONS' : 'PERGUNTAS FREQUENTES'}</p><h2>{isEn ? 'Vox Seas FAQ' : 'Perguntas frequentes sobre Vox Seas'}</h2><div class="faq-list">{guide.faqs.map((faq) => <details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div></section>}
        <div class="verification-note"><Icon name="clock" size={19} /><p>{isEn ? `Reviewed on ${guide.updated}. Game updates can change prices, rewards and mechanics without notice.` : `Conteúdo revisado em ${guide.updated}. Atualizações do jogo podem alterar preços, recompensas e mecânicas sem aviso.`}</p></div>
      </article>
      <aside class="guide-sidebar">
        {toc.length > 0 && <nav class="toc-card" aria-label={isEn ? 'On this page' : 'Nesta página'}><h2>{isEn ? 'On this page' : 'Neste guia'}</h2>{toc.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>}
        <div class="sidebar-cta"><span class="sidebar-cta-icon"><Icon name="ticket" size={22} /></span><h2>{isEn ? 'Before you sail' : 'Antes de zarpar'}</h2><p>{isEn ? 'Check the latest codes and claim your free rewards.' : 'Confira os códigos mais recentes e garanta suas recompensas grátis.'}</p><a href={isEn ? '/en/codes/' : '/codigos/'}>{isEn ? 'View Vox Seas codes' : 'Ver códigos de Vox Seas'}<Icon name="arrow" size={16} /></a></div>
        <a class="wiki-home-link" href={isEn ? '/en/codes/' : '/'}><Icon name="compass" size={19} />{isEn ? 'Vox Seas guide home' : 'Voltar à Vox Seas wiki'}<Icon name="arrow" size={16} /></a>
      </aside>
    </div>
    <section class="related-section"><div class="section-heading"><div><p class="eyebrow">{isEn ? 'KEEP EXPLORING' : 'CONTINUE EXPLORANDO'}</p><h2>{isEn ? 'Related guides' : 'Próximas paradas'}</h2></div></div><div class="related-grid">{relatedItems.map((item) => item && <a class="related-card" href={item.href}><span class="related-icon"><Icon name={item.icon} size={22} /></span><h3>{item.title}</h3><p>{item.description}</p><span class="text-link">{isEn ? 'Read guide' : 'Abrir guia'}<Icon name="arrow" size={16} /></span></a>)}</div></section>
  </div>
</BaseLayout>
