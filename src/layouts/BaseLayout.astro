---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import { languageLinks, localizedRoutes, type Locale } from '../data/guides';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: Locale | 'th';
  path?: string;
  updatedISO?: string;
  schema?: Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description,
  lang = 'pt-BR',
  path = Astro.url.pathname,
  updatedISO = site.updatedISO,
  schema = [],
  bodyClass = '',
} = Astro.props;
const canonical = new URL(path, site.url).href;
const isEn = lang === 'en';
const alternates = localizedRoutes(path);
const alternate = alternates?.[isEn ? 'pt-BR' : 'en'];
const graph = [
  { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, url: `${site.url}/`, logo: { '@type': 'ImageObject', url: `${site.url}/favicon.svg` } },
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, inLanguage: ['pt-BR', 'en', 'th'], publisher: { '@id': `${site.url}/#organization` } },
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: lang, isPartOf: { '@id': `${site.url}/#website` }, dateModified: updatedISO },
  { '@type': 'VideoGame', '@id': `${site.url}/#game`, name: 'Vox Seas', url: site.robloxUrl, gamePlatform: 'Roblox', genre: ['RPG', 'Adventure'] },
  ...schema,
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta name="theme-color" content="#081e25" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {languageLinks(path, site.url).map((link) => <link rel="alternate" hreflang={link.lang} href={link.url} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : isEn ? 'en_US' : 'pt_BR'} />
    <meta property="og:image" content={`${site.url}/og-vox-seas.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}></script>
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4183802444188513"
      crossorigin="anonymous"
    ></script>
    {import.meta.env.PROD && (
      <script is:inline>
        if (['voxseas.online', 'www.voxseas.online'].includes(window.location.hostname)) {
          const gtmScript = document.createElement('script');
          gtmScript.async = true;
          gtmScript.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-K66MWK5R';
          document.head.appendChild(gtmScript);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
        }
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{lang === 'th' ? 'ข้ามไปยังเนื้อหา' : isEn ? 'Skip to content' : 'Pular para o conteúdo'}</a>
    <Header lang={lang} alternate={alternate} />
    <LanguageSuggestion lang={lang} />
    <main id="main-content"><slot /></main>
    <Footer lang={lang} alternate={alternate} />
  </body>
</html>
