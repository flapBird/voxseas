---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props { lang?: 'pt-BR' | 'en'; }
const { lang = 'pt-BR' } = Astro.props;
const isEn = lang === 'en';
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand" href={isEn ? '/en/' : '/'}><span class="brand-mark"><Icon name="compass" size={25} /></span><span class="brand-type">VOX SEAS<small>{isEn ? 'PLAYER GUIDE' : 'GUIA BRASILEIRO'}</small></span></a>
      <p>{isEn ? 'A practical, independent guide to help you enjoy Vox Seas without getting lost at sea.' : 'Um guia prático e independente para você aproveitar Vox Seas sem se perder no mar.'}</p>
      <a class="footer-roblox" href={site.robloxUrl} target="_blank" rel="noopener noreferrer">Roblox<Icon name="external" size={15} /></a>
    </div>
    <div class="footer-column">
      <h2>{isEn ? 'Guides' : 'Guias'}</h2>
      <a href={isEn ? '/en/' : '/guias/'}>{isEn ? 'All guides' : 'Todos os guias'}</a>
      {!isEn && <a href="/iniciante/">Guia para iniciantes</a>}
      <a href={isEn ? '/en/codes/' : '/codigos/'}>{isEn ? 'Codes' : 'Códigos'}</a>
      <a href={isEn ? '/en/tier-list/' : '/tier-list/'}>Tier list</a>
    </div>
    {!isEn && (
      <div class="footer-column">
        <h2>Wiki</h2>
        <a href="/frutas/">Fruitdex</a>
        <a href="/mapa/">Mapa e ilhas</a>
        <a href="/armas/">Armas</a>
        <a href="/chefes/">Chefes</a>
        <a href="/racas/">Raças</a>
      </div>
    )}
    <div class="footer-column">
      <h2>{isEn ? 'Community' : 'Comunidade'}</h2>
      <a href={isEn ? '/en/discord/' : '/discord/'}>Discord</a>
      <a href={isEn ? '/en/trello/' : '/trello/'}>Trello</a>
      {!isEn && <a href="/lancamento/">Lançamento e retorno</a>}
      <a href={isEn ? '/guias/' : '/en/'} hreflang={isEn ? 'pt-BR' : 'en'}>{isEn ? 'Português' : 'English'}</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>© 2026 Vox Seas {isEn ? 'Guide' : 'Brasil'}.</p>
    <p>{isEn ? 'Independent fan site. Not affiliated with Roblox Corporation or the Vox Seas developers.' : 'Site independente, sem afiliação à Roblox Corporation nem aos desenvolvedores de Vox Seas.'}</p>
  </div>
</footer>
