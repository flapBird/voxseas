---
import { infoPages } from '../data/info-pages';
import Icon from './Icon.astro';
import { getGuideLinks, thaiPageFor, routes, type Locale } from '../data/guides';

interface Props { lang?: Locale; alternate?: string; }
const { lang = 'pt-BR', alternate } = Astro.props;
const isEn = lang === 'en';
const other = isEn ? 'pt-BR' : 'en';
const guides = getGuideLinks(lang);
const thai = thaiPageFor(Astro.url.pathname);
const columns = [
  { title: isEn ? 'Guides' : 'Guias', links: ['beginner', 'codes', 'tiers'], directory: true },
  { title: 'Wiki', links: ['fruits', 'map', 'weapons', 'bosses', 'races'] },
  { title: isEn ? 'Community' : 'Comunidade', links: ['discord', 'trello', 'relaunch'], language: true },
];
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand" href={routes.home[lang]}><span class="brand-mark"><Icon name="compass" size={25} /></span><span class="brand-type">VOX SEAS<small>{isEn ? 'PLAYER GUIDE' : 'GUIA BRASILEIRO'}</small></span></a>
      <p>{isEn ? 'A practical, independent guide to help you enjoy Vox Seas without getting lost at sea.' : 'Um guia prático e independente para você aproveitar Vox Seas sem se perder no mar.'}</p>
    </div>
    {columns.map((column) => (
      <div class="footer-column">
        <h2>{column.title}</h2>
        {column.directory && <a href={routes.directory[lang]}>{isEn ? 'All guides' : 'Todos os guias'}</a>}
        {guides.filter((guide) => column.links.includes(guide.route)).map((guide) => (
          <a href={guide.href}>{guide.title}</a>
        ))}
        {column.language && thai && <a href={thai.path} lang="th" hreflang="th" data-language-choice="th">ไทย</a>}
        {column.language && <a href={alternate ?? routes.home[other]} lang={other} hreflang={other} data-language-choice={other}>{isEn ? 'Português' : 'English'}</a>}
      </div>
    ))}
  </div>
  <nav class="shell info-links" aria-label={isEn ? 'Site information' : 'Informações do site'}>
    {infoPages.map(page => <a href={page.paths[lang]}>{page.titles[lang]}</a>)}
  </nav>
  <div class="shell footer-bottom">
    <p>© 2026 Vox Seas {isEn ? 'Guide' : 'Brasil'}.</p>
    <p>{isEn ? 'Independent fan site. Not affiliated with Roblox Corporation or the Vox Seas developers.' : 'Site independente, sem afiliação à Roblox Corporation nem aos desenvolvedores de Vox Seas.'}</p>
  </div>
</footer>

<style>
  .info-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; padding-bottom: 1.25rem; color: #a9bfc2; font-size: 0.8rem; }
  @media (min-width: 701px) { .info-links { justify-content: flex-end; } }
  .info-links a:hover { color: var(--lime); }
</style>
