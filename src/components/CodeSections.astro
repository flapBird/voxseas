---
import CodeList from './CodeList.astro';
import { archivedCodes, codeReviews, codesReviewedISO, formatReviewStamp, pendingCodes } from '../data/codes';
import type { Locale } from '../data/guides';
import { entryId } from '../lib/search-text';

interface Props { lang?: Locale; }
const { lang = 'pt-BR' } = Astro.props;
const isEn = lang === 'en';
---
<section id={isEn ? 'working-codes' : 'codigos-ativos'} class="codes-page-panel">
  <div class="codes-panel-heading">
    <h2>{isEn ? 'Codes to try' : 'Códigos para resgatar'}</h2>
    <time datetime={codesReviewedISO}>
      {isEn ? 'Checked on' : 'Verificado em'} {formatReviewStamp(codesReviewedISO, lang, true)} BRT
    </time>
  </div>
  <CodeList lang={lang} />
  <p class="code-disclaimer">{isEn ? 'Status checked against public reports.' : 'Status conferido em fontes públicas.'}</p>
  {pendingCodes.length > 0 && <>
    <h3>{isEn ? 'Awaiting confirmation' : 'Aguardando confirmação'}</h3>
    <CodeList lang={lang} pending />
  </>}
</section>
<h2 id={isEn ? 'code-history' : 'historico'}>{isEn ? 'Update log' : 'Histórico de atualizações'}</h2>
<ul>
  {codeReviews.map(({ checkedAt, note }) => <li><time datetime={checkedAt}>{formatReviewStamp(checkedAt, lang)}</time> — {note[lang]}</li>)}
</ul>
<h2 id={isEn ? 'archived-codes' : 'codigos-antigos'}>{isEn ? 'Expired codes' : 'Códigos expirados'}</h2>
<ul>
  {archivedCodes.map((code) => <li id={entryId('code', code)}><code>{code}</code> — {isEn ? 'Expired' : 'Expirado'}</li>)}
</ul>
