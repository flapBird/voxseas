---
import GuideLinks from './GuideLinks.astro';
import Icon from './Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGuideLinks, guideGroups, routes, type Locale } from '../data/guides';
import { site } from '../data/site';

interface Props { lang?: Locale; }
const { lang = 'pt-BR' } = Astro.props;
const isEn = lang === 'en';
const items = getGuideLinks(lang);
const groups = guideGroups.map((group) => ({ key: group.key, ...group[lang] }));
const title = isEn ? 'Vox Seas Guides' : 'Guias de Vox Seas';
const description = isEn
  ? 'Browse every Vox Seas guide in English, including the beginner route, codes, fruits, islands, weapons, races and bosses.'
  : 'Todos os guias de Vox Seas em português. Encontre o passo a passo inicial, códigos, frutas, ilhas, armas, raças e chefes.';
const schema = [{
  '@type': 'ItemList',
  name: title,
  itemListElement: items.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.title, url: new URL(item.href, site.url).href })),
}];
---
<BaseLayout title={title} description={description} lang={lang} schema={schema}>
  <div class="shell directory-shell">
    <nav class="breadcrumbs" aria-label={isEn ? 'Breadcrumb' : 'Trilha de navegação'}>
      <a href={routes.home[lang]}>{isEn ? 'Home' : 'Início'}</a><Icon name="chevron" size={14} /><span aria-current="page">{isEn ? 'Guides' : 'Guias'}</span>
    </nav>
    <header class="directory-header">
      <h1>{title}</h1>
      <p>{isEn ? 'Find the guide you need, from your first quest to your next Boss Room.' : 'Da primeira missão à próxima Boss Room, encontre o guia da sua etapa no jogo.'}</p>
    </header>
    <nav class="directory-jump" aria-label={isEn ? 'Guide topics' : 'Categorias de guias'}>
      {groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
    </nav>
    {groups.map((group) => (
      <section class="directory-group" aria-labelledby={group.id}>
        <h2 id={group.id}>{group.title}</h2>
        <GuideLinks items={items.filter((item) => item.group === group.key)} />
      </section>
    ))}
  </div>
</BaseLayout>
