---
import Icon from './Icon.astro';
import { codes } from '../data/codes';
import type { Locale } from '../data/guides';
import { entryId } from '../lib/search-text';

interface Props { lang?: Locale; limit?: number; }
const { lang = 'pt-BR', limit } = Astro.props;
const isEn = lang === 'en';
const compact = limit !== undefined;
const visibleCodes = compact ? codes.filter(({ source }) => source === 'trello').slice(0, limit) : codes;
const sourceLabels = { trello: 'Trello', reported: isEn ? 'Reported' : 'Relatado' };
---
<div class:list={['code-list', { 'code-list-compact': compact }]}>
  {visibleCodes.map((item) => (
    <article class="code-item" id={entryId('code', item.code)}>
      {!compact && <div class="code-status">{sourceLabels[item.source]}</div>}
      <div class="code-main"><code>{item.code}</code><p>{compact && item.source === 'trello' ? item.compactReward[lang] : item.reward[lang]}</p></div>
      <button class="copy-button" type="button" data-copy={item.code} aria-label={`${isEn ? 'Copy code' : 'Copiar código'} ${item.code}`} hidden>
        <Icon class="copy-default" name="copy" size={17} /><Icon class="copy-success" name="check" size={17} /><span data-copy-label>{isEn ? 'Copy' : 'Copiar'}</span>
      </button>
    </article>
  ))}
  <p class="copy-feedback sr-only" role="status" data-copy-feedback></p>
</div>
<script>
  const isEn = document.documentElement.lang === 'en';
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const item = button.closest('.code-item')!;
    const label = button.querySelector<HTMLElement>('[data-copy-label]')!;
    const feedback = button.closest('.code-list')!.querySelector<HTMLElement>('[data-copy-feedback]')!;
    const code = button.dataset.copy!;
    let timeout: number;
    button.hidden = false;

    button.addEventListener('click', async () => {
      window.clearTimeout(timeout);
      feedback.textContent = '';
      try {
        await navigator.clipboard.writeText(code);
        button.classList.add('copied');
        label.textContent = isEn ? 'Copied' : 'Copiado';
        feedback.classList.add('sr-only');
        feedback.textContent = isEn ? `${code} copied.` : `Código ${code} copiado.`;
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(item.querySelector('code')!);
        selection?.removeAllRanges();
        selection?.addRange(range);
        feedback.classList.remove('sr-only');
        feedback.textContent = isEn ? `Copy ${code} manually from the list.` : `Copie ${code} manualmente na lista.`;
      }
      timeout = window.setTimeout(() => {
        button.classList.remove('copied');
        label.textContent = isEn ? 'Copy' : 'Copiar';
      }, 1800);
    });
  }
</script>
