---
import { languageLinks, type Locale } from '../data/guides';
import { site } from '../data/site';

interface Props { lang: Locale | 'th'; }
const { lang } = Astro.props;
const labels = {
  'pt-BR': ['Prefere ler em português?', 'Ler em português', 'Continuar em português'],
  en: ['Prefer to read in English?', 'Read in English', 'Stay in English'],
  th: ['ต้องการอ่านภาษาไทยไหม?', 'อ่านภาษาไทย', 'อ่านภาษาไทยต่อ'],
};
const alternatives = languageLinks(Astro.url.pathname, site.url).filter(link => link.lang !== lang && link.lang !== 'x-default');
---
{alternatives.map(link => {
  const other = link.lang as keyof typeof labels;
  return <div class="language-suggestion" data-language-suggestion={other} lang={other} hidden>
    <div class="shell language-suggestion-inner">
      <p>{labels[other][0]}</p>
      <div class="language-suggestion-actions">
        <a href={new URL(link.url).pathname} hreflang={other} data-language-choice={other}>{labels[other][1]}</a>
        <button type="button" lang={lang} data-language-choice={lang}>{labels[lang][2]}</button>
      </div>
    </div>
  </div>;
})}

<script>
  const key = 'voxseas-language';
  const suggestions = document.querySelectorAll<HTMLElement>('[data-language-suggestion]');
  let chosenLanguage: string | null = null;

  function suggestedLanguage() {
    try {
      const stored = localStorage.getItem(key);
      if (stored === 'en' || stored === 'pt-BR' || stored === 'th') return stored;
    } catch {
      // The language links still work if storage is disabled.
    }
    if (chosenLanguage) return chosenLanguage;

    const preferences = navigator.languages?.length ? navigator.languages : [navigator.language];
    const firstSupported = preferences.map((language) => language.toLowerCase().split('-')[0]).find((language) => language === 'en' || language === 'pt' || language === 'th');
    return firstSupported === 'pt' ? 'pt-BR' : firstSupported;
  }

  function updateSuggestion() {
    const preference = suggestedLanguage();
    for (const suggestion of suggestions) suggestion.hidden = preference !== suggestion.dataset.languageSuggestion;
  }

  document.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !(event.target instanceof Element)) return;
    const choice = event.target.closest<HTMLElement>('[data-language-choice]')?.dataset.languageChoice;
    if (choice !== 'en' && choice !== 'pt-BR' && choice !== 'th') return;

    chosenLanguage = choice;
    try {
      localStorage.setItem(key, choice);
    } catch {
      // Keep the choice for the current page if storage is disabled.
    }
    if (choice === document.documentElement.lang) {
      updateSuggestion();
      if (event.detail === 0) document.querySelector<HTMLAnchorElement>('.language-link')?.focus();
    }
  });

  updateSuggestion();
  window.addEventListener('pageshow', updateSuggestion);
</script>
