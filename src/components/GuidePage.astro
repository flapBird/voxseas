---
import { render, type CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import GuideLayout from '../layouts/GuideLayout.astro';
import ReferenceTable from './ReferenceTable.astro';
import { entityRoute, routes, type Locale } from '../data/guides';
import { getReferences } from '../data/references';
import fruitsArt from '../assets/art/fruitdex-gameplay-v1.webp';
import weaponsArt from '../assets/art/cutlass-gameplay-v1.webp';
import mapArt from '../assets/art/world-map-gameplay-v1.webp';
import bossArt from '../assets/art/captain-jester-gameplay-v1.webp';

interface Props { entry: CollectionEntry<'guides'> | CollectionEntry<'en'>; }
const { entry } = Astro.props;
const lang: Locale = entry.collection === 'en' ? 'en' : 'pt-BR';
const path = lang === 'en' ? `/en/${entry.id}/` : `/${entry.id}/`;
const { Content, headings } = await render(entry);
const reference = getReferences(lang).find((item) => item.path === path);
const sections = reference ? [{ depth: 2, ...reference.heading }, ...headings] : headings;
const artwork = [
  {
    route: routes.fruits,
    src: fruitsArt,
    alt: {
      'pt-BR': 'Interface do Fruitdex com a fruta Thorn e o progresso de descoberta em Vox Seas',
      en: 'The Fruitdex showing Thorn and discovery progress in Vox Seas',
    },
  },
  {
    route: routes.weapons,
    src: weaponsArt,
    alt: {
      'pt-BR': 'Hango oferece a opção Take the Cutlass durante o diálogo em Vox Seas',
      en: 'Hango offers the Take the Cutlass dialogue option in Vox Seas',
    },
  },
  {
    route: routes.map,
    src: mapArt,
    alt: {
      'pt-BR': 'Mapa-múndi de Vox Seas com Solmar Island, Harbor Island e Shark Park',
      en: 'Vox Seas world map showing Solmar Island, Harbor Island and Shark Park',
    },
  },
  {
    route: routes.bosses,
    src: bossArt,
    alt: {
      'pt-BR': 'Batalha contra Captain Jester em uma arena com interface de combate de Vox Seas',
      en: 'An arena battle against Captain Jester in Vox Seas',
    },
  },
];
const guideArt = artwork.find(({ route }) => route[lang] === path);
const entity = entityRoute(path);
const profileImages = import.meta.glob<ImageMetadata>('../assets/entities/*.webp', { eager: true, import: 'default' });
const profileImage = entity && profileImages[`../assets/entities/${entity.slug}.webp`];
const source = entry.data.art?.source;
const credit = source
  ? (lang === 'en' ? 'Image from the official Vox Seas Trello' : 'Imagem do Trello oficial de Vox Seas')
  : (lang === 'en' ? 'Gameplay screenshot · Vox Seas Wiki' : 'Captura de gameplay · Vox Seas Wiki');
---
<GuideLayout guide={entry.data} headings={sections} lang={lang} path={path} art={profileImage ?? guideArt?.src} artAlt={entry.data.art?.alt ?? guideArt?.alt[lang]} artCredit={credit} artSource={source}>
  <Fragment slot="reference">{reference && <ReferenceTable reference={reference} lang={lang} />}</Fragment>
  <Content />
</GuideLayout>
